# Firebase Realtime Database URL (Lecture 6 – environment variables).
# 1. Firebase console -> Build -> Realtime Database -> Create database (test mode)
# 2. Paste its URL below, e.g. https://masroufi-12345-default-rtdb.firebaseio.com
# Leave empty to run the app offline-only (SQLite cache).
FIREBASE_DB_URL=
# Optional: database secret / ID token if your rules are locked.
FIREBASE_AUTH=
